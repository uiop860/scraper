{
  "manifest_version": 3,
  "name": "Scraper",
  "version": "0.1.0",
  "description": "Extract structured data locally using JSON specifications, with optional experimental ChatGPT sign-in.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Scrape this page"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "scraper@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    }
  },
  "permissions": ["storage", "declarativeNetRequest", "scripting", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://auth.openai.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["callback.html"],
      "matches": ["http://127.0.0.1/*", "https://auth.openai.com/*"]
    }
  ],
  "incognito": "not_allowed",
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
